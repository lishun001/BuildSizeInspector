{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "rule_version": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "enum": [
        "observed",
        "correlated",
        "hypothesis"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "apk_entry",
            "unity_asset",
            "config",
            "build",
            "container"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "key"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "metric": {
      "enum": [
        "zip_compressed_bytes",
        "unity_packed_bytes",
        "apk_overhead_bytes",
        "none"
      ]
    },
    "delta_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "additive": {
      "const": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "artifact_role": {
            "enum": [
              "apk",
              "build_meta",
              "unity_report",
              "asset_importers",
              "git_changes",
              "packages_lock",
              "derived_analysis"
            ]
          },
          "artifact_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "artifact_role",
          "artifact_sha256",
          "locator",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "suggested_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_state": {
      "enum": [
        "unreviewed",
        "confirmed",
        "rejected"
      ]
    }
  },
  "required": [
    "schema_version",
    "rule_id",
    "rule_version",
    "confidence",
    "severity",
    "subject",
    "title",
    "explanation",
    "metric",
    "delta_bytes",
    "additive",
    "evidence",
    "suggested_checks",
    "review_state"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BuildSize finding v1"
}
