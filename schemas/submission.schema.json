{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "variant": {
      "type": "string",
      "minLength": 1
    },
    "ci": {
      "type": "object",
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "job_full_name": {
          "type": "string",
          "minLength": 1
        },
        "build_number": {
          "type": "string",
          "minLength": 1
        },
        "build_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "instance_id",
        "job_full_name",
        "build_number",
        "build_url"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "apk",
              "build_meta",
              "unity_report",
              "asset_importers",
              "git_changes",
              "packages_lock"
            ]
          },
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "role",
          "filename",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "project_key",
    "variant",
    "ci",
    "artifacts"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BuildSize submission manifest v1"
}
