{
  "name": "buildsize-inspector-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "generate": "node scripts/generate-contracts.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src/App.tsx src/api.ts src/components.tsx src/main.tsx src/types.ts src/style.css vite.config.ts playwright.config.ts tests/browser/flows.spec.ts playwright.stack.config.ts tests/stack.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "packageManager": "pnpm@11.1.3",
  "dependencies": {
    "antd": "6.7.1",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "type": "module"
}
