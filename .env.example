# M0–M6：复制为 .env，设置本地值。空 secret 会阻止 API 启动。
APP_ENV=development
# 浏览器通过 Vite 同源代理访问 API；纯 API 调试可改为本机 8000 origin。
PUBLIC_BASE_URL=http://127.0.0.1:5173
DATABASE_URL=
POSTGRES_PASSWORD=
SESSION_SECRET=
TOKEN_HASH_PEPPER=
TRUSTED_LINK_HOSTS=
APK_DOWNLOAD_HOSTS=

# API、Worker、scheduler 必须从同一工程目录启动并共享此 Blob 目录。
REDIS_URL=redis://127.0.0.1:6379/0
BLOB_ROOT=.buildsize/blobs
UPLOAD_MAX_BYTES=2147483648
UPLOAD_TIMEOUT_SECONDS=900
ANALYSIS_TIMEOUT_SECONDS=1200
WORKER_CONCURRENCY=1
# M6 最早保留期限；current/pin/固定基线/活跃任务受保护，实际清理默认关闭。
APK_RETENTION_DAYS=30
REPORT_RETENTION_DAYS=180
METRICS_RETENTION_DAYS=365
ANDROID_SDK_ROOT=
APK_ANALYZER_ENABLED=false
